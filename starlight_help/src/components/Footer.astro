---
import {SUPPORT_EMAIL} from "astro:env/client";

const footer_html = `<p>Don't see an answer to your question? <a href="mailto:${SUPPORT_EMAIL}">Contact this Grow Team server's administrators</a> for support.</p>`;
---

<footer class="sl-flex">
    <hr />
    <Fragment set:html={footer_html} />
</footer>

<style>
    @layer starlight.core {
        footer {
            flex-direction: column;
            gap: 1.5rem;
        }
    }
</style>
