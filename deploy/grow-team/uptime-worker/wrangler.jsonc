{
  "name": "grow-team-uptime",
  "account_id": "ba7401c904e8adc0e35e1fa42cbc2580",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/2 * * * *"] },
  "vars": { "CHECK_URL": "https://team.growc.id/login/" },
  "services": [{ "binding": "MAIL", "service": "grow-team-email" }],
  "durable_objects": { "bindings": [{ "name": "MONITOR", "class_name": "UptimeMonitor" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UptimeMonitor"] }],
  "observability": { "enabled": true }
}
