# Salin ke /etc/grow-team/offsite-backup.env (root:root, mode 0600). Jangan commit nilai asli.
# Endpoint S3 R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
# API token R2 dengan izin Object Read & Write, dibatasi ke bucket di atas.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public key age (age1...). Private key-nya disimpan di luar server.
AGE_RECIPIENT=
# Opsional: jumlah salinan di R2 yang dipertahankan.
#OFFSITE_KEEP=14
