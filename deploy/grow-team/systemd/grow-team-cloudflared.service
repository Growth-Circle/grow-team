[Unit]
Description=Grow Team Cloudflare Tunnel
Wants=network-online.target
After=network-online.target grow-team.service
StartLimitIntervalSec=0

[Service]
Type=simple
DynamicUser=yes
User=grow-team-cloudflared
Slice=grow-team.slice
LoadCredential=tunnel-token:/etc/grow-team/secrets/cloudflared-token
ExecStart=/opt/grow-team/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:18400 run --token-file %d/tunnel-token
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=256M
TasksMax=128

[Install]
WantedBy=multi-user.target
