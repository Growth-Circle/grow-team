[Unit]
Description=Grow Team agent runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/lib/grow-agent/bin/node %h/.local/lib/grow-agent/dist/cli.js run
Environment=GROW_AGENT_STATE=%h/.local/state/grow-agent
UMask=0077
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
