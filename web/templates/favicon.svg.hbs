<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
    <style>
        @font-face {
        font-family: 'Source Sans 3';
        font-style: normal;
        font-weight: 700;
        src: url({{{favicon_font_url_html}}}) format('truetype');
        }
    </style>
    <rect width="32" height="32" rx="8" fill="{{#if have_pm}}#FF6A3D{{else}}#16161D{{/if}}"/>
    <g transform="translate(5.2 5.2) scale(.45)" fill="{{#if have_pm}}#16161D{{else}}#FFFAF0{{/if}}">
        <path d="M34 5H15.5a9.5 9.5 0 0 0 0 19H34z"/>
        <path d="M14 26h21a7 7 0 0 1 7 7v3a7 7 0 0 1-7 7H14z"/>
        <circle cx="41" cy="12" r="5"/>
    </g>
    <g transform="scale(2)">
    <text x="15" y="15" text-anchor="end"
      font-family="'Source Sans 3'" font-weight="bold" letter-spacing="-0.5"
      fill="#16161D" stroke="#16161D" stroke-width="2" stroke-linejoin="round" opacity=".5"
      {{#if count_long}}font-size="9" textLength="14" lengthAdjust="spacingAndGlyphs"{{else}}font-size="11"{{/if}}>
        {{count}}
    </text>
    <text x="15" y="15" text-anchor="end"
      font-family="'Source Sans 3'" font-weight="bold" letter-spacing="-0.5"
      fill="#FFFAF0"
      {{#if count_long}}font-size="9" textLength="14" lengthAdjust="spacingAndGlyphs"{{else}}font-size="11"{{/if}}>
        {{count}}
    </text>
    </g>
</svg>
