<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16">
    <style>
        @font-face {
        font-family: 'Source Sans 3';
        font-style: normal;
        font-weight: 700;
        src: url({{{favicon_font_url_html}}}) format('truetype');
        }
    </style>
    <g transform="scale(.5)"><circle cx="16" cy="16" r="15" fill="#087f70"/><g fill="#fff"><circle cx="16" cy="10.5" r="3"/><circle cx="8.5" cy="14" r="2.3"/><circle cx="23.5" cy="14" r="2.3"/><path d="M11 22v-3a5 5 0 0 1 10 0v3h-10ZM4.5 23v-3a4 4 0 0 1 5.2-3.8A7 7 0 0 0 9 19v4H4.5ZM23 23v-4a7 7 0 0 0-.7-2.8 4 4 0 0 1 5.2 3.8v3H23Z"/></g></g>
    <text x="15" y="15" text-anchor="end"
      font-family="'Source Sans 3'" font-weight="bold" letter-spacing="-0.5"
      fill="white" stroke="white" stroke-width="2" stroke-linejoin="round" opacity=".5"
      {{#if count_long}}font-size="9" textLength="14" lengthAdjust="spacingAndGlyphs"{{else}}font-size="11"{{/if}}>
        {{count}}
    </text>
    <text x="15" y="15" text-anchor="end"
      font-family="'Source Sans 3'" font-weight="bold" letter-spacing="-0.5"
      {{#if count_long}}font-size="9" textLength="14" lengthAdjust="spacingAndGlyphs"{{else}}font-size="11"{{/if}}>
        {{count}}
    </text>
    {{#if have_pm}}
    <circle cx="14" cy="4" r="2" fill="#f00" />
    {{/if}}
</svg>
