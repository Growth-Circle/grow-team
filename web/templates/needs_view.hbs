{{! The Needs you page: everything that waits on this person across
every room, in tabs, and what the person finished today. }}
<div class="needs-page">
    {{#> components/page_header . eyebrow=header_eyebrow title=(t "Needs you")}}
        <div class="needs-tabs" role="group" aria-label="{{t 'Kinds of request'}}">
            {{#each tabs}}
                <button
                  type="button"
                  class="needs-tab{{#if this.active}} needs-tab-active{{/if}}{{#if this.is_empty}} needs-tab-empty{{/if}}"
                  data-tab="{{this.value}}"
                  aria-pressed="{{#if this.active}}true{{else}}false{{/if}}"
                  >{{this.label}}</button>
            {{/each}}
        </div>
    {{/components/page_header}}

    {{#if (or team_wide_toggle can_mark_all stale_unread_label)}}
        <div class="needs-filter">
            {{#if team_wide_toggle}}
                <button
                  type="button"
                  class="needs-team-wide-toggle"
                  aria-pressed="{{#if team_wide_toggle.is_on}}true{{else}}false{{/if}}"
                  >{{team_wide_toggle.label}}</button>
            {{/if}}
            {{#if can_mark_all}}
                <button type="button" class="needs-mark-all">{{t "Mark all done"}}</button>
            {{/if}}
            {{#if stale_unread_label}}
                <button type="button" class="mark-stale-read needs-stale-read"><span class="mark-stale-read-label">{{stale_unread_label}}</span></button>
            {{/if}}
        </div>
    {{/if}}

    {{#if load_failed}}
        {{> components/empty_state tone="warning" role="alert" title=(t "Your list did not load.") action_label=(t "Try again") action_classes="needs-btn needs-btn-secondary needs-retry"}}
    {{else if loading}}
        <div class="needs-list" aria-busy="true">
            <div class="needs-skeleton sj-skeleton"></div>
            <div class="needs-skeleton sj-skeleton"></div>
            <div class="needs-skeleton sj-skeleton"></div>
        </div>
    {{else}}
        {{#if is_empty}}
            {{> components/empty_state tone="success" icon="✓" title=empty_text}}
        {{/if}}
        {{#each rows}}
            {{#if this.is_group}}
                {{> need_group . }}
            {{else}}
                {{> need_card . }}
            {{/if}}
        {{/each}}
        {{#if show_done}}
            <div class="needs-done">
                <span class="needs-done-label">{{done_label}}</span>
                {{#each done_rows}}
                    <div class="needs-done-row" data-need-id="{{this.id}}">
                        <span class="needs-done-check" aria-hidden="true">✓</span>
                        <span class="needs-done-text">{{this.text}}</span>
                        {{#if this.room}}
                            <span class="needs-done-room"># {{this.room}}</span>
                        {{/if}}
                    </div>
                {{/each}}
            </div>
        {{/if}}
    {{/if}}
</div>
