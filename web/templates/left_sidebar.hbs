<div class="left-sidebar" id="left-sidebar" role="navigation">
    <div id="left-sidebar-workspace-switcher" class="hidden-for-spectators"></div>
    <button type="button" id="left-sidebar-command-search" class="left-sidebar-command-search hidden">
        <span class="left-sidebar-command-search-label">{{t "Search or ask Kaki"}}</span>
        <kbd id="left-sidebar-command-search-hint" class="left-sidebar-command-search-hint"></kbd>
    </button>
    <div id="left-sidebar-search">
        <div class="input-wrapper-for-tooltip tippy-zulip-delayed-tooltip" data-tooltip-template-id="filter-left-sidebar-tooltip-template">
            {{#> components/input_wrapper input_type="filter-input" custom_classes="left-sidebar-search-section" icon="search" input_button_icon="close"}}
                <input type="text" class="input-element left-sidebar-search-input" autocomplete="off" placeholder="{{t 'Filter left sidebar' }}" />
            {{/components/input_wrapper}}
        </div>
        <span id="add_streams_button" class="add-stream-icon-container hidden-for-spectators" tabindex="0">
            <i id="streams_inline_icon" class="add_stream_icon zulip-icon zulip-icon-square-plus" aria-hidden="true" ></i>
        </span>
        <span class="sidebar-menu-icon channel-folders-sidebar-menu-icon hidden-for-spectators" tabindex="0"><i class="zulip-icon zulip-icon-more-vertical" aria-label="{{t 'Show channel folders'}}"></i></span>
    </div>
    <ul id="left-sidebar-empty-list-message" class="hidden">
        {{> empty_list_widget_for_list
          empty_list_message=(t "No matches.")
          }}
    </ul>
    <div id="left-sidebar-navigation-area" class="left-sidebar-navigation-area hidden-for-spectators">
        <ul id="left-sidebar-navigation-list" class="left-sidebar-navigation-list filters">
            <li class="sanji-nav-item" data-nav-id="home">
                <a href="#today" class="sanji-nav-link">
                    <span class="sanji-nav-label">
                        <span class="sanji-nav-dot" aria-hidden="true"></span>
                        <span>{{t "Today"}}</span>
                    </span>
                </a>
            </li>
            <li class="sanji-nav-item" data-nav-id="needs">
                <a href="#needs" class="sanji-nav-link">
                    <span class="sanji-nav-label">
                        <span class="sanji-nav-dot" aria-hidden="true"></span>
                        <span>{{t "Needs you"}}</span>
                    </span>
                    <span class="unread_count sanji-nav-badge hide"></span>
                </a>
            </li>
            <li class="sanji-nav-item top_left_my_tasks" data-nav-id="tasks">
                <a href="#tasks" class="sanji-nav-link">
                    <span class="sanji-nav-label">
                        <span class="sanji-nav-dot" aria-hidden="true"></span>
                        <span>{{t "Task board"}}</span>
                    </span>
                    <span class="unread_count sanji-nav-badge hide"></span>
                </a>
            </li>
            <li class="sanji-nav-item" data-nav-id="agents">
                <a href="#agents" class="sanji-nav-link">
                    <span class="sanji-nav-label">
                        <span class="sanji-nav-dot" aria-hidden="true"></span>
                        <span>{{t "Agents"}}</span>
                    </span>
                </a>
            </li>
            <li class="sanji-nav-item" data-nav-id="mcp">
                <a href="#mcp" class="sanji-nav-link">
                    <span class="sanji-nav-label">
                        <span class="sanji-nav-dot" aria-hidden="true"></span>
                        <span>{{t "MCP connections"}}</span>
                    </span>
                    <span class="unread_count sanji-nav-badge hide"></span>
                </a>
            </li>
            <li class="sanji-nav-item" data-nav-id="runners">
                <a href="#runners" class="sanji-nav-link">
                    <span class="sanji-nav-label">
                        <span class="sanji-nav-dot" aria-hidden="true"></span>
                        <span>{{t "Runners"}}</span>
                    </span>
                    <span class="unread_count sanji-nav-badge hide"></span>
                </a>
            </li>
            <li class="sanji-nav-item" data-nav-id="drive">
                <a href="#drive" class="sanji-nav-link">
                    <span class="sanji-nav-label">
                        <span class="sanji-nav-dot" aria-hidden="true"></span>
                        <span>{{t "Drive"}}</span>
                    </span>
                </a>
            </li>
            <li class="sanji-nav-item" data-nav-id="settings">
                <a href="#workspace-settings/general" class="sanji-nav-link">
                    <span class="sanji-nav-label">
                        <span class="sanji-nav-dot" aria-hidden="true"></span>
                        <span>{{t "Settings"}}</span>
                    </span>
                </a>
            </li>
        </ul>
    </div>
    {{~!-- squash whitespace --~}}
    <div id="left_sidebar_scroll_container" class="scrolling_list" data-simplebar data-simplebar-tab-index="-1">
        <div id="sidebar-rooms-header" class="sidebar-rooms-header">
            <h4 class="sidebar-rooms-title">{{t "ROOMS"}}</h4>
            <button type="button" id="left-sidebar-new-room-button" class="left-sidebar-new-room-button" aria-label="{{t 'New room'}}">+</button>
        </div>
        <div id="streams_list">
            <div id="stream-filters-container">
                <ul id="stream_filters" class="filters"></ul>
                <div id="sidebar-no-rooms-cta" class="hidden">
                    <button type="button" class="sidebar-no-rooms-button">{{t "Create room"}}</button>
                </div>
                {{#unless is_guest }}
                    <div id="subscribe-to-more-streams"></div>
                {{/unless}}
                <div id="login-to-more-streams" class="only-visible-for-spectators login_button">
                    <a class="subscribe-more-link" tabindex="0">
                        <i class="subscribe-more-icon zulip-icon zulip-icon-log-in" aria-hidden="true" ></i>
                        <span class="subscribe-more-label">{{~t "LOG IN TO BROWSE MORE" ~}}</span>
                    </a>
                </div>
            </div>
        </div>
        <div id="sidebar-quiet-rooms"></div>
        <div id="direct-messages-section-header" class="left-sidebar-section-header direct-messages-container zoomed-out">
            <i id="toggle-direct-messages-section-icon" class="zulip-icon zulip-icon-heading-triangle-right sidebar-heading-icon rotate-icon-down dm-tooltip-target" aria-hidden="true" tabindex="0" role="button"></i>
            <h4 class="left-sidebar-title"><span class="dm-tooltip-target">{{t "Direct messages"}}</span></h4>
            <div class="left-sidebar-controls">
                <a class="show-all-direct-messages tippy-left-sidebar-tooltip-no-label-delay" href="#narrow/is/dm" data-tooltip-template-id="show-all-direct-messages-template">
                    <i class="zulip-icon zulip-icon-all-messages" aria-label="{{t 'Direct message feed' }}"></i>
                </a>
                <span class="compose-new-direct-message tippy-left-sidebar-tooltip-no-label-delay auto-hide-left-sidebar-overlay" tabindex="0" data-tooltip-template-id="new_direct_message_button_tooltip_template">
                    <i class="left-sidebar-new-direct-message-icon zulip-icon zulip-icon-square-plus" aria-label="{{t 'Start a new DM' }}"></i>
                </span>
            </div>
            <div class="heading-markers-and-unreads">
                <span class="unread_count"></span>
            </div>
        </div>
        <div class="direct-messages-container zoomed-out hidden-for-spectators">
            <div id="direct-messages-list"></div>
        </div>
        <div class="direct-message-section-bottom-divider-container">
            <hr class="direct-message-section-bottom-divider"/>
        </div>
    </div>
    <div id="left-sidebar-modal">
        <div class="left-sidebar-modal-close-area" tabindex="0">
            <div class="left-sidebar-modal-back">
                <i class="zulip-icon zulip-icon-arrow-left" aria-hidden="true"></i>
                <span>Back</span>
            </div>
            <i class="zulip-icon zulip-icon-close"></i>
        </div>
        <div id="left-sidebar-modal-content">
            <div id="direct-messages-modal" class="no-display">
                <div id="direct-messages-modal-section-header" class="direct-messages-container">
                    <h4 class="left-sidebar-title"><span class="dm-tooltip-target">{{t "ALL DIRECT MESSAGES" }}</span></h4>
                    <div class="left-sidebar-controls">
                        <a class="show-all-direct-messages tippy-left-sidebar-tooltip-no-label-delay" href="#narrow/is/dm" data-tooltip-template-id="show-all-direct-messages-template">
                            <i class="zulip-icon zulip-icon-all-messages" aria-label="{{t 'Direct message feed' }}"></i>
                        </a>
                        <span class="compose-new-direct-message tippy-left-sidebar-tooltip-no-label-delay auto-hide-left-sidebar-overlay" data-tooltip-template-id="new_direct_message_button_tooltip_template">
                            <i class="left-sidebar-new-direct-message-icon zulip-icon zulip-icon-square-plus" aria-label="{{t 'New direct message' }}"></i>
                        </span>
                    </div>
                    <div class="heading-markers-and-unreads">
                        <span class="unread_count"></span>
                    </div>
                    <div class="direct-messages-search-section left-sidebar-filter-input-container">
                        {{#> components/input_wrapper input_type="filter-input" icon="search" input_button_icon="close"}}
                            <input type="text" class="input-element direct-messages-list-filter home-page-input" autocomplete="off" placeholder="{{t 'Filter direct messages' }}" />
                        {{/components/input_wrapper}}
                    </div>
                </div>
                <div id="modal-direct-messages-list" class="scrolling_list" data-simplebar data-simplebar-tab-index="-1"></div>
            </div>
            <div id="more-topics-modal"></div>
        </div>
    </div>
    <div id="sidebar-user-card" class="hidden-for-spectators"></div>
</div>
