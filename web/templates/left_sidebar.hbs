<div class="left-sidebar" id="left-sidebar" role="navigation">
    {{> components/action_button
        custom_classes="left-sidebar-new-conversation-button compose_new_conversation_button"
        icon="pencil"
        variant="solid"
        intent="brand"
        label=(t "Start new conversation")
        aria-label=(t "Start new conversation")
    }}
    <div id="left-sidebar-search">
        <div class="input-wrapper-for-tooltip tippy-zulip-delayed-tooltip" data-tooltip-template-id="filter-left-sidebar-tooltip-template">
            {{#> components/input_wrapper input_type="filter-input" custom_classes="left-sidebar-search-section" icon="search" input_button_icon="close"}}
                <input type="text" class="input-element left-sidebar-search-input" autocomplete="off" placeholder="{{t 'Filter left sidebar' }}" />
            {{/components/input_wrapper}}
        </div>
        <span id="add_streams_button" class="add-stream-icon-container hidden-for-spectators" tabindex="0">
            <i id="streams_inline_icon" class="add_stream_icon zulip-icon zulip-icon-square-plus" aria-hidden="true" ></i>
        </span>
        <span class="sidebar-menu-icon channel-folders-sidebar-menu-icon hidden-for-spectators" tabindex="0"><i class="zulip-icon zulip-icon-more-vertical" aria-label="{{t 'Show channel folders'}}"></i></span>
    </div>
    <ul id="left-sidebar-empty-list-message" class="hidden">
        {{> empty_list_widget_for_list
          empty_list_message=(t "No matches.")
          }}
    </ul>
    {{!-- The Work group mirrors the Conversations group below it: the same
    header grid and the same row grid, so both groups share one layout. The
    counts come from task_board_ui.render_work_counts(). --}}
    <div id="left-sidebar-work-area" class="left-sidebar-navigation-area hidden-for-spectators">
        <div id="work-section-header" class="left-sidebar-section-header" role="button" tabindex="0" aria-expanded="true" aria-controls="left-sidebar-work-list">
            <i id="toggle-work-section-icon" class="zulip-icon zulip-icon-heading-triangle-right sidebar-heading-icon rotate-icon-down" aria-hidden="true"></i>
            {{~!-- squash whitespace --~}}
            <h4 class="left-sidebar-title"><span>{{t "Work"}}</span></h4>
        </div>
        <ul id="left-sidebar-work-list" class="left-sidebar-navigation-list filters">
            <li class="top_left_row top_left_task_board">
                <a href="#tasks" class="left-sidebar-navigation-label-container tippy-left-sidebar-tooltip" data-tooltip-template-id="work-section-task-board-tooltip-template">
                    <span class="filter-icon"><i class="zulip-icon zulip-icon-todo-list" aria-hidden="true"></i></span>
                    {{~!-- squash whitespace --~}}
                    <span class="left-sidebar-navigation-label">{{t "Task board"}}</span>
                    <span class="unread_count quiet-count hide"></span>
                </a>
            </li>
            <li class="top_left_row top_left_my_tasks">
                <a href="#tasks/mine" class="left-sidebar-navigation-label-container tippy-left-sidebar-tooltip" data-tooltip-template-id="work-section-my-tasks-tooltip-template">
                    <span class="filter-icon"><i class="zulip-icon zulip-icon-check" aria-hidden="true"></i></span>
                    {{~!-- squash whitespace --~}}
                    <span class="left-sidebar-navigation-label">{{t "My tasks"}}</span>
                    <span class="unread_count normal-count hide"></span>
                </a>
            </li>
            <li class="top_left_row top_left_awaiting_review">
                <a href="#tasks/review" class="left-sidebar-navigation-label-container tippy-left-sidebar-tooltip" data-tooltip-template-id="work-section-awaiting-review-tooltip-template">
                    <span class="filter-icon"><i class="zulip-icon zulip-icon-git-pull-request" aria-hidden="true"></i></span>
                    {{~!-- squash whitespace --~}}
                    <span class="left-sidebar-navigation-label">{{t "Awaiting my review"}}</span>
                    <span class="unread_count normal-count hide"></span>
                </a>
            </li>
            <li class="top_left_row top_left_agent_tasks">
                <a href="#agent-jobs" class="left-sidebar-navigation-label-container tippy-left-sidebar-tooltip" data-tooltip-template-id="work-section-agent-tasks-tooltip-template">
                    <span class="filter-icon"><i class="zulip-icon zulip-icon-bot" aria-hidden="true"></i></span>
                    {{~!-- squash whitespace --~}}
                    <span class="left-sidebar-navigation-label">{{t "Agent tasks"}}</span>
                    <span class="unread_count normal-count hide"></span>
                </a>
            </li>
        </ul>
    </div>
    <template id="work-section-task-board-tooltip-template">{{t "Task board" }}</template>
    <template id="work-section-my-tasks-tooltip-template">{{t "My tasks" }}</template>
    <template id="work-section-awaiting-review-tooltip-template">{{t "Awaiting my review" }}</template>
    <template id="work-section-agent-tasks-tooltip-template">{{t "Agent tasks" }}</template>
    <div id="left-sidebar-navigation-area" class="left-sidebar-navigation-area">
        <div id="views-label-container" class="left-sidebar-section-header showing-expanded-navigation{{#if is_spectator}} remove-pointer-for-spectator{{/if}}">
            <i id="toggle-top-left-navigation-area-icon" class="zulip-icon zulip-icon-heading-triangle-right sidebar-heading-icon rotate-icon-down views-tooltip-target hidden-for-spectators" aria-hidden="true" tabindex="0" role="button"></i>
            {{~!-- squash whitespace --~}}
            <h4 class="left-sidebar-title"><span class="views-tooltip-target">{{t "Conversations"}}</span></h4>
            <ul id="left-sidebar-navigation-list-condensed" class="filters">
                {{#each primary_condensed_views}}
                    {{> left_sidebar_primary_condensed_view_item . }}
                {{/each}}
                <li class="top_left_condensed_unread_marker left-sidebar-navigation-condensed-item">
                    <span class="unread_count normal-count"></span>
                </li>
            </ul>
            <div class="left-sidebar-navigation-menu-icon">
                <i class="zulip-icon zulip-icon-more-vertical" aria-label="{{t 'Other views'}}"></i>
            </div>
        </div>
        <ul id="left-sidebar-navigation-list" class="left-sidebar-navigation-list filters">
            {{> left_sidebar_expanded_view_items_list expanded_views=expanded_views}}
        </ul>
    </div>
    {{~!-- squash whitespace --~}}
    <div id="left_sidebar_scroll_container" class="scrolling_list" data-simplebar data-simplebar-tab-index="-1">
        <div id="streams_list">
            <div id="stream-filters-container">
                <ul id="stream_filters" class="filters"></ul>
                {{#unless is_guest }}
                    <div id="subscribe-to-more-streams"></div>
                {{/unless}}
                <div id="login-to-more-streams" class="only-visible-for-spectators login_button">
                    <a class="subscribe-more-link" tabindex="0">
                        <i class="subscribe-more-icon zulip-icon zulip-icon-log-in" aria-hidden="true" ></i>
                        <span class="subscribe-more-label">{{~t "LOG IN TO BROWSE MORE" ~}}</span>
                    </a>
                </div>
            </div>
        </div>
        <div id="direct-messages-section-header" class="left-sidebar-section-header direct-messages-container zoomed-out">
            <i id="toggle-direct-messages-section-icon" class="zulip-icon zulip-icon-heading-triangle-right sidebar-heading-icon rotate-icon-down dm-tooltip-target" aria-hidden="true" tabindex="0" role="button"></i>
            <h4 class="left-sidebar-title"><span class="dm-tooltip-target">{{t "Direct messages"}}</span></h4>
            <div class="left-sidebar-controls">
                <a class="show-all-direct-messages tippy-left-sidebar-tooltip-no-label-delay" href="#narrow/is/dm" data-tooltip-template-id="show-all-direct-messages-template">
                    <i class="zulip-icon zulip-icon-all-messages" aria-label="{{t 'Direct message feed' }}"></i>
                </a>
                <span class="compose-new-direct-message tippy-left-sidebar-tooltip-no-label-delay auto-hide-left-sidebar-overlay" tabindex="0" data-tooltip-template-id="new_direct_message_button_tooltip_template">
                    <i class="left-sidebar-new-direct-message-icon zulip-icon zulip-icon-square-plus" aria-label="{{t 'Start a new DM' }}"></i>
                </span>
            </div>
            <div class="heading-markers-and-unreads">
                <span class="unread_count"></span>
            </div>
        </div>
        <div class="direct-messages-container zoomed-out hidden-for-spectators">
            <div id="direct-messages-list"></div>
        </div>
        <div class="direct-message-section-bottom-divider-container">
            <hr class="direct-message-section-bottom-divider"/>
        </div>
    </div>
    <div id="left-sidebar-modal">
        <div class="left-sidebar-modal-close-area" tabindex="0">
            <div class="left-sidebar-modal-back">
                <i class="zulip-icon zulip-icon-arrow-left" aria-hidden="true"></i>
                <span>Back</span>
            </div>
            <i class="zulip-icon zulip-icon-close"></i>
        </div>
        <div id="left-sidebar-modal-content">
            <div id="direct-messages-modal" class="no-display">
                <div id="direct-messages-modal-section-header" class="direct-messages-container">
                    <h4 class="left-sidebar-title"><span class="dm-tooltip-target">{{t "ALL DIRECT MESSAGES" }}</span></h4>
                    <div class="left-sidebar-controls">
                        <a class="show-all-direct-messages tippy-left-sidebar-tooltip-no-label-delay" href="#narrow/is/dm" data-tooltip-template-id="show-all-direct-messages-template">
                            <i class="zulip-icon zulip-icon-all-messages" aria-label="{{t 'Direct message feed' }}"></i>
                        </a>
                        <span class="compose-new-direct-message tippy-left-sidebar-tooltip-no-label-delay auto-hide-left-sidebar-overlay" data-tooltip-template-id="new_direct_message_button_tooltip_template">
                            <i class="left-sidebar-new-direct-message-icon zulip-icon zulip-icon-square-plus" aria-label="{{t 'New direct message' }}"></i>
                        </span>
                    </div>
                    <div class="heading-markers-and-unreads">
                        <span class="unread_count"></span>
                    </div>
                    <div class="direct-messages-search-section left-sidebar-filter-input-container">
                        {{#> components/input_wrapper input_type="filter-input" icon="search" input_button_icon="close"}}
                            <input type="text" class="input-element direct-messages-list-filter home-page-input" autocomplete="off" placeholder="{{t 'Filter direct messages' }}" />
                        {{/components/input_wrapper}}
                    </div>
                </div>
                <div id="modal-direct-messages-list" class="scrolling_list" data-simplebar data-simplebar-tab-index="-1"></div>
            </div>
            <div id="more-topics-modal"></div>
        </div>
    </div>
</div>
