<form id="task-board-new-card-form">
    <div class="input-group">
        <label for="task-board-new-title" class="modal-field-label">{{t "Title"}}</label>
        <input type="text" id="task-board-new-title" class="modal_text_input" maxlength="200" autocomplete="off" />
    </div>
    <div class="input-group">
        <label for="task-board-new-body" class="modal-field-label">{{t "Description"}}</label>
        <textarea id="task-board-new-body" class="modal_text_input" rows="3"></textarea>
    </div>
</form>
