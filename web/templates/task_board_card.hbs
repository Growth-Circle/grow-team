{{! One card. Reads, from top to bottom: where the conversation came from,
    the title, optional supporting rows, then labels, id and assignee. }}
<article class="task-board-card{{#if blocked}} task-board-card-blocked{{/if}}" data-task-id="{{id}}" draggable="true" tabindex="0" role="button">
    {{#if origin_label}}
    <p class="task-board-card-origin" title="{{origin_label}}">
        <i class="zulip-icon zulip-icon-hash" aria-hidden="true"></i>
        <span class="task-board-card-origin-label">{{origin_label}}</span>
    </p>
    {{/if}}
    <h3 class="task-board-card-title">{{title}}</h3>
    {{#if checklist_label}}
    <p class="task-board-card-detail">
        <i class="zulip-icon zulip-icon-todo-list" aria-hidden="true"></i>
        <span>{{checklist_label}}</span>
    </p>
    <div class="task-board-card-progress" role="progressbar" aria-valuemin="0" aria-valuemax="{{checklist_total}}" aria-valuenow="{{checklist_done}}">
        <div class="task-board-card-progress-fill" style="width: {{checklist_percent}}%"></div>
    </div>
    {{/if}}
    {{#if due_label}}
    <p class="task-board-card-detail{{#if due_is_overdue}} task-board-card-detail-danger{{/if}}">
        <i class="zulip-icon zulip-icon-clock" aria-hidden="true"></i>
        <span>{{due_label}}</span>
    </p>
    {{/if}}
    {{#if completed_label}}
    <p class="task-board-card-detail task-board-card-detail-done">
        <i class="zulip-icon zulip-icon-check" aria-hidden="true"></i>
        <span>{{completed_label}}</span>
    </p>
    {{/if}}
    <footer class="task-board-card-footer">
        <span class="task-board-card-tags">
            {{#if blocked}}
            <span class="task-board-chip task-board-chip-blocked">{{t "Blocked"}}</span>
            {{/if}}
            {{#if agent_label}}
            <span class="task-board-chip task-board-chip-agent">
                <i class="zulip-icon zulip-icon-bot" aria-hidden="true"></i>
                <span>{{agent_label}}</span>
            </span>
            {{/if}}
            {{#each labels}}
            <span class="task-board-chip">{{this}}</span>
            {{/each}}
        </span>
        <span class="task-board-card-identity">
            <span class="task-board-card-id">{{display_id}}</span>
            {{#if assignee}}
            <span class="task-board-card-avatar" title="{{assignee.full_name}}">
                <img class="task-board-card-avatar-image" src="{{assignee.avatar_url}}" alt="{{assignee.full_name}}" />
            </span>
            {{else}}
            <span class="task-board-card-avatar task-board-card-avatar-empty" title="{{t 'Nobody is responsible for this card'}}">—</span>
            {{/if}}
        </span>
    </footer>
</article>
