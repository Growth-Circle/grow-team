{{! One item that waits on the person: the avatar of who asked, a kind
tag, where and when, the text, an optional attachment, and the actions.
The Needs you page and the Today page both render it. }}
<article class="needs-card{{#if is_new}} needs-card-new{{/if}}" data-need-id="{{id}}">
    {{#if is_human}}
        <span class="needs-avatar needs-avatar-human" aria-hidden="true">{{initials}}</span>
    {{else}}
        <span class="needs-avatar needs-avatar-{{avatar_shape}}" style="color: {{avatar_color}}" aria-hidden="true"></span>
    {{/if}}
    <div class="needs-body">
        <div class="needs-meta-row">
            <span class="needs-tag needs-tag-{{kind}}">{{tag}}</span>
            {{#if team_wide}}
                <span class="needs-tag needs-tag-team-wide">{{t "Team-wide"}}</span>
            {{/if}}
            <span class="needs-meta">{{meta}}</span>
        </div>
        {{#if mcp_call}}
            <dl class="needs-mcp-details">
                <div class="needs-mcp-detail">
                    <dt>{{t "Action"}}</dt>
                    <dd>{{mcp_call.tool_label}}</dd>
                </div>
                <div class="needs-mcp-detail">
                    <dt>{{t "Goes to"}}</dt>
                    <dd>{{mcp_call.target}}</dd>
                </div>
                {{#if mcp_call.has_mentions}}
                    <div class="needs-mcp-detail">
                        <dt>{{t "Mentions"}}</dt>
                        <dd>{{mcp_call.mentions}}</dd>
                    </div>
                {{/if}}
                <div class="needs-mcp-detail">
                    <dt>{{t "Expires"}}</dt>
                    <dd>{{mcp_call.expires}}</dd>
                </div>
                <div class="needs-mcp-detail">
                    <dt>{{t "Digest"}}</dt>
                    <dd><code>{{mcp_call.digest}}</code></dd>
                </div>
            </dl>
            {{#if mcp_call.has_content}}
                <p class="needs-mcp-content">{{mcp_call.content}}</p>
            {{/if}}
            {{#if mcp_call.can_expand}}
                <button type="button" class="needs-mcp-more" data-need-id="{{id}}" aria-expanded="{{#if mcp_call.expanded}}true{{else}}false{{/if}}">{{mcp_call.expand_label}}</button>
            {{/if}}
        {{else}}
            <p class="needs-text line-clamp">{{text}}</p>
        {{/if}}
        {{#if excerpt}}
            <p class="needs-excerpt line-clamp">{{excerpt}}</p>
        {{/if}}
        {{#if attachment}}
            <span class="needs-attachment"><span aria-hidden="true">📎</span> {{attachment.filename}}</span>
        {{/if}}
    </div>
    <div class="needs-actions">
        {{#each actions}}
            {{#if this.href}}
                <a class="needs-btn needs-btn-{{this.variant}}" href="{{this.href}}">{{this.label}}</a>
            {{else if this.is_snooze}}
                <button
                  type="button"
                  class="needs-btn needs-btn-secondary needs-card-snooze"
                  data-need-id="{{../id}}"
                  >{{this.label}}</button>
            {{else if this.is_expired}}
                <button type="button" class="needs-btn needs-btn-expired" aria-disabled="true">{{this.label}}</button>
            {{else}}
                <button
                  type="button"
                  class="needs-btn needs-btn-{{this.variant}} needs-card-{{this.variant}}"
                  data-need-id="{{../id}}"
                  data-choice="{{this.choice}}"
                  >{{this.label}}</button>
            {{/if}}
        {{/each}}
    </div>
</article>
