<div class="hide two-pane-settings-right-simplebar-container" id="stream-creation" tabindex="-1" role="dialog"
  aria-modal="true" aria-labelledby="create_channel_dialog_title">
    <h2 class="create-channel-dialog-title" id="create_channel_dialog_title">{{t "Create channel" }}</h2>
    <form id="stream_creation_form" novalidate>
        <div class="two-pane-settings-creation-simplebar-container">
            <div class="alert stream_create_info"></div>
            <div id="stream_creating_indicator"></div>
            <div class="stream-creation-body">
                <div class="create-channel-form stream_creation_container">
                    <section id="create_stream_title_container">
                        <label for="create_stream_name">
                            {{t "Channel name" }}
                        </label>
                        <input type="text" name="stream_name" id="create_stream_name" class="settings_text_input"
                          placeholder="{{t 'Channel name' }}" value="" autocomplete="off" maxlength="{{ max_stream_name_length }}" />
                        <div id="stream_name_error" class="stream_creation_error"></div>
                    </section>
                    <section class="subscribers_container create-channel-members">
                        <div class="stream_create_add_subscriber_container">
                            <div class="create-channel-members-header">
                                <h4 class="stream_setting_subsection_title new-stream-subscribers-title">
                                    <label class="choose-subscribers-label">{{t "Members" }}</label>
                                    <span class="create-channel-members-count" id="create_stream_members_count"></span>
                                </h4>
                                <button type="button" class="create-channel-all-team-button" id="create_stream_add_all_team">{{t "+ All team" }}</button>
                            </div>
                            <div id="stream_subscription_error" class="stream_creation_error"></div>
                            <div class="controls" id="people_to_add"></div>
                        </div>
                    </section>
                    <section id="create_stream_chat_type_container" class="create-channel-choice-section">
                        <span class="settings-field-label" id="create_stream_chat_type_label">{{t "Chat type" }}</span>
                        <div class="create-channel-choices" role="radiogroup" aria-labelledby="create_stream_chat_type_label" aria-describedby="create_stream_chat_type_reason">
                            <label class="create-channel-choice">
                                <input type="radio" class="create-channel-choice-input" name="create_stream_chat_type" value="topic" checked />
                                <span class="create-channel-choice-text">
                                    <span class="create-channel-choice-title">{{t "By topic" }}</span>
                                    <span class="create-channel-choice-help">{{t "A tidy thread for each matter. Good for clients and projects." }}</span>
                                </span>
                            </label>
                            <label class="create-channel-choice">
                                <input type="radio" class="create-channel-choice-input" name="create_stream_chat_type" value="flat" />
                                <span class="create-channel-choice-text">
                                    <span class="create-channel-choice-title">{{t "No topics" }}</span>
                                    <span class="create-channel-choice-help">{{t "One running conversation, like a messaging app." }}</span>
                                </span>
                            </label>
                        </div>
                        <p class="create-channel-choice-reason hide" id="create_stream_chat_type_reason">{{t "You cannot change this here. New channels use the workspace default." }}</p>
                    </section>
                    <div class="create-channel-visibility-folder">
                        <section id="create_stream_visibility_container" class="create-channel-choice-section">
                            <span class="settings-field-label" id="create_stream_visibility_label">{{t "Who can see it" }}</span>
                            <div class="create-channel-segmented" role="radiogroup" aria-labelledby="create_stream_visibility_label" aria-describedby="create_stream_visibility_reason">
                                <label class="create-channel-segment">
                                    <input type="radio" class="create-channel-segment-input" name="create_stream_visibility" value="private" />
                                    <span class="create-channel-segment-label">{{t "Only members" }}</span>
                                </label>
                                <label class="create-channel-segment">
                                    <input type="radio" class="create-channel-segment-input" name="create_stream_visibility" value="public" />
                                    <span class="create-channel-segment-label">{{t "Everyone on the team" }}</span>
                                </label>
                            </div>
                            <p class="create-channel-choice-reason hide" id="create_stream_visibility_reason"></p>
                        </section>
                        <section class="create-channel-folder">
                            {{> channel_folder .
                              is_stream_edit=false
                              channel_folder_widget_name="new_channel_folder_id"
                              hide_create_folder_button=true
                              }}
                        </section>
                    </div>
                    <section class="create-channel-more-settings">
                        <button type="button" class="create-channel-more-settings-toggle" aria-expanded="false" aria-controls="create_channel_more_settings">
                            <i class="fa fa-sm fa-caret-right create-channel-more-settings-icon" aria-hidden="true"></i>
                            <span class="create-channel-more-settings-title">{{t "More settings" }}</span>
                            <span class="create-channel-more-settings-hint">{{t "description, announcement, permissions, retention…" }}</span>
                        </button>
                        <div id="create_channel_more_settings" class="create-channel-more-settings-body hide">
                            <section id="create_stream_description_container">
                                <label for="create_stream_description" class="settings-field-label">
                                    {{t "Channel description" }}
                                    {{> ../help_link_widget link="/help/change-the-channel-description" }}
                                </label>
                                <input type="text" name="stream_description" id="create_stream_description" class="settings_text_input"
                                  placeholder="{{t 'Channel description' }}" value="" autocomplete="off" maxlength="{{ max_stream_description_length }}" />
                            </section>
                            <section id="make-invite-only">
                                <div class="new-stream-configuration">
                                    {{> new_stream_configuration .
                                      prefix="id_new_"}}
                                </div>
                            </section>
                        </div>
                    </section>
                </div>
            </div>
        </div>
        <div class="settings-sticky-footer">
            <div class="settings-sticky-footer-left">
                <span class="create-channel-enter-hint">{{t "Press Enter to create" }}</span>
            </div>
            <div class="settings-sticky-footer-right">
                {{> ../components/action_button
                  label=(t "Cancel")
                  custom_classes="create_stream_cancel inline-block"
                  variant="subtle"
                  intent="neutral"
                  }}
                {{> ../components/action_button
                  label=(t "Create channel")
                  custom_classes="finalize_create_stream inline-block"
                  variant="solid"
                  intent="brand"
                  type="submit"
                  }}
            </div>
        </div>
    </form>
    <button type="button" class="create-channel-dialog-close" aria-label="{{t 'Close' }}">
        <i class="zulip-icon zulip-icon-close" aria-hidden="true"></i>
    </button>
</div>
