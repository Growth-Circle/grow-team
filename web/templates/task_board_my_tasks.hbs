{{! My tasks: the reader's open cards, grouped by deadline. The card
    detail panel is shared with the board. }}
<div class="task-board-header">
    <div class="task-board-identity">
        <h1 class="task-board-name" tabindex="-1">{{t "My tasks"}}</h1>
    </div>
    {{> task_board_view_switch . }}
    <p class="task-board-summary">{{summary}}</p>
    {{#if card_unavailable}}
        <p class="task-board-notice" role="status">{{t "This card isn't available."}}</p>
    {{/if}}
</div>
{{#if is_empty}}
    <p class="task-board-empty task-board-list-empty">{{t "You have no open tasks. Cards assigned to you show up here."}}</p>
{{else}}
    <div class="task-board-list">
        {{#each sections}}
            <section class="task-board-list-section" data-section="{{this.section}}" aria-labelledby="task-board-list-heading-{{this.section}}">
                <h2 class="task-board-list-heading{{#if this.is_overdue}} task-board-list-heading-overdue{{/if}}" id="task-board-list-heading-{{this.section}}">
                    <span>{{this.title}}</span>
                    <span class="task-board-column-count">{{this.card_count}}</span>
                </h2>
                <ul class="task-board-list-rows">
                    {{#each this.cards}}
                        <li>
                            <div class="task-board-list-row" data-task-id="{{this.id}}" tabindex="0" role="button">
                                <span class="task-board-list-row-main">
                                    <span class="task-board-list-row-title">{{this.title}}</span>
                                    {{#if this.origin_label}}
                                        <span class="task-board-list-row-origin">{{this.origin_label}}</span>
                                    {{/if}}
                                </span>
                                <span class="task-board-list-row-tags">
                                    {{#if this.priority_name}}
                                        <span class="task-board-chip task-board-chip-priority task-board-chip-priority-{{this.priority_name}}">{{this.priority_label}}</span>
                                    {{/if}}
                                    {{#if this.blocked}}
                                        <span class="task-board-chip task-board-chip-blocked">{{t "Blocked"}}</span>
                                    {{/if}}
                                    {{#each this.labels}}
                                        <span class="task-board-chip">{{this}}</span>
                                    {{/each}}
                                </span>
                                <span class="task-board-list-row-meta">
                                    {{#if this.due_label}}
                                        <span class="task-board-list-row-due{{#if this.due_is_overdue}} task-board-card-detail-danger{{/if}}">{{this.due_label}}</span>
                                    {{/if}}
                                    <span class="task-board-card-id">{{this.display_id}}</span>
                                </span>
                            </div>
                        </li>
                    {{/each}}
                </ul>
            </section>
        {{/each}}
    </div>
{{/if}}
