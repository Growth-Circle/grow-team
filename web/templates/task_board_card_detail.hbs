{{! The card detail panel, opened from a card on the board. }}
<div class="task-board-detail-header">
    <span class="task-board-detail-id">{{display_id}}</span>
    <span class="task-board-chip">{{column_name}}</span>
    {{#if agent_label}}
        <span class="task-board-chip task-board-chip-agent">
            <i class="zulip-icon zulip-icon-bot" aria-hidden="true"></i>
            <span>{{agent_label}}</span>
        </span>
    {{/if}}
    <button type="button" class="task-board-detail-close" aria-label="{{t 'Close card'}}">
        <i class="zulip-icon zulip-icon-close" aria-hidden="true"></i>
    </button>
</div>
<h2 class="task-board-detail-title" tabindex="-1">{{title}}</h2>
{{#if body}}
    <p class="task-board-detail-body">{{body}}</p>
{{/if}}

<div class="task-board-detail-chat-row">
    <button type="button" class="task-board-detail-chat action-button action-button-subtle-neutral action-button-small">
        <i class="zulip-icon {{#if has_channel}}zulip-icon-message-square{{else}}zulip-icon-file-text{{/if}}" aria-hidden="true"></i>
        <span class="action-button-label">{{#if has_channel}}{{t "Chat"}}{{else}}{{t "Open notes"}}{{/if}}</span>
    </button>
    {{#if plan_is_ready}}
        <button type="button" class="task-board-detail-plan action-button action-button-subtle-neutral action-button-small" aria-pressed="{{#if is_planned_today}}true{{else}}false{{/if}}">
            <i class="zulip-icon zulip-icon-calendar" aria-hidden="true"></i>
            <span class="action-button-label">{{#if is_planned_today}}{{t "Remove from today"}}{{else}}{{t "Add to today"}}{{/if}}</span>
        </button>
    {{/if}}
</div>

<section class="task-board-detail-section task-board-status"aria-labelledby="task-board-status-heading">
    <h3 id="task-board-status-heading">{{t "Status"}}</h3>
    {{#if can_move}}
        <div class="task-board-status-controls">
            <label class="task-board-status-field" for="task-board-status-column">
                <span>{{t "Move to"}}</span>
                <select id="task-board-status-column" class="task-board-status-select">
                    {{#each status_columns}}
                        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                    {{/each}}
                </select>
            </label>
            <label class="task-board-status-field" for="task-board-status-position">
                <span>{{t "Position"}}</span>
                <select id="task-board-status-position" class="task-board-status-select">
                    <option value="top" {{#if status_edge_is_top}}selected{{/if}}>{{t "Top of column"}}</option>
                    <option value="bottom" {{#unless status_edge_is_top}}selected{{/unless}}>{{t "Bottom of column"}}</option>
                </select>
            </label>
            <button type="button" id="task-board-status-save" class="task-board-status-save action-button action-button-solid-brand" {{#if status_save_disabled}}disabled{{/if}}>
                <span class="action-button-label">{{t "Save"}}</span>
            </button>
        </div>
        <p class="task-board-status-error" role="alert">{{status_error}}</p>
    {{else}}
        <p class="task-board-status-current">{{column_name}}</p>
        <p class="task-board-status-hint">{{move_hint}}</p>
    {{/if}}
</section>

<section class="task-board-detail-section">
    <h3>{{t "Where this card came from"}}</h3>
    {{#if origin_label}}
        <p class="task-board-detail-origin">
            <i class="zulip-icon zulip-icon-hash" aria-hidden="true"></i>
            <span>{{origin_label}}</span>
        </p>
        {{#if origin_url}}
            <a class="task-board-detail-origin-link" href="{{origin_url}}">{{t "Open the conversation"}}</a>
        {{/if}}
    {{else}}
        <p class="task-board-detail-origin">{{t "This card was created on the board."}}</p>
    {{/if}}
    <p class="task-board-detail-created">{{created_label}}</p>
</section>

{{#if has_checklist}}
    <section class="task-board-detail-section">
        <h3>{{t "Checklist"}}</h3>
        <ul class="task-board-detail-checklist">
            {{#each checklist}}
                <li>
                    <label>
                        <input type="checkbox" class="task-board-detail-checklist-item" data-index="{{this.index}}" {{#if this.done}}checked{{/if}} />
                        <span>{{this.text}}</span>
                    </label>
                </li>
            {{/each}}
        </ul>
    </section>
{{/if}}

<section class="task-board-detail-section">
    <h3>{{t "Responsible"}}</h3>
    {{#if can_edit}}
        <button type="button" id="task-board-assignee_widget" class="task-board-assignee-row task-board-assignee-button">
            {{> task_board_assignee_row . }}
        </button>
    {{else}}
        <div class="task-board-assignee-row">
            {{> task_board_assignee_row . }}
        </div>
    {{/if}}
</section>

<section class="task-board-detail-section task-board-planning" aria-labelledby="task-board-planning-heading">
    <h3 id="task-board-planning-heading">{{t "Priority and labels"}}</h3>
    {{#if can_edit}}
        <label class="task-board-status-field" for="task-board-priority">
            <span>{{t "Priority"}}</span>
            <select id="task-board-priority" class="task-board-status-select">
                {{#each priorities}}
                    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
            </select>
        </label>
    {{else}}
        <p class="task-board-detail-priority">{{priority_current_label}}</p>
    {{/if}}
    <ul class="task-board-detail-labels" aria-label="{{t 'Labels'}}">
        {{#each labels}}
            <li class="task-board-chip task-board-label">
                <span>{{this}}</span>
                {{#if ../can_edit}}
                    <button type="button" class="task-board-label-remove" data-label="{{this}}" aria-label="{{t 'Remove label {label}' label=this}}">
                        <i class="zulip-icon zulip-icon-close" aria-hidden="true"></i>
                    </button>
                {{/if}}
            </li>
        {{else}}
            {{#unless can_edit}}
                <li class="task-board-detail-labels-empty">{{t "No labels"}}</li>
            {{/unless}}
        {{/each}}
    </ul>
    {{#if can_edit}}
        <input type="text" id="task-board-label-input" class="task-board-label-input" maxlength="40" autocomplete="off" placeholder="{{t 'Add a label and press Enter'}}" aria-label="{{t 'Add a label'}}" />
        <p class="task-board-label-error" role="alert">{{label_error}}</p>
    {{/if}}

    <h3>{{t "Deadline"}}</h3>
    {{#if can_edit}}
        <div class="task-board-due-controls">
            <input type="date" id="task-board-due-input" class="task-board-status-select task-board-due-input" value="{{due_input_value}}" aria-label="{{t 'Deadline'}}" />
            {{#if due_label}}
                <button type="button" class="task-board-due-clear action-button action-button-subtle-neutral action-button-small">
                    <span class="action-button-label">{{t "Clear"}}</span>
                </button>
            {{/if}}
        </div>
    {{else if due_label}}
        <p class="task-board-detail-due{{#if due_is_overdue}} task-board-card-detail-danger{{/if}}">{{due_label}}</p>
    {{else}}
        <p class="task-board-detail-due">{{t "No deadline"}}</p>
    {{/if}}
</section>

{{> task_board_notes . }}

{{#if agent_job_url}}
    <section class="task-board-detail-section">
        <h3>{{t "Agent work"}}</h3>
        <a class="task-board-detail-agent-link" href="{{agent_job_url}}">{{t "Open the agent task"}}</a>
    </section>
{{/if}}

<section class="task-board-detail-section">
    <h3>{{t "History"}}</h3>
    <ul class="task-board-detail-history">
        {{#each history}}
            <li>
                <span class="task-board-detail-history-time">{{this.time_label}}</span>
                <span class="task-board-detail-history-text">{{this.text}}</span>
            </li>
        {{else}}
            <li class="task-board-detail-history-empty">{{t "Loading…"}}</li>
        {{/each}}
    </ul>
</section>

<div class="task-board-detail-actions">
    <button type="button" class="task-board-detail-delete action-button action-button-subtle-danger action-button-small">
        <span class="action-button-label">{{t "Delete card"}}</span>
    </button>
</div>
