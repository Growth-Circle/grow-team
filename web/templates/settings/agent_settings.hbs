<div class="settings-section" id="agent-settings" data-name="agents">
    <div class="section-header"><h2>{{t "Agents"}}</h2><p>{{t
                "Manage agent profiles, devices, model connections, and the team default."
            }}</p></div>
    <p
        id="agent-settings-status"
        class="alert"
        role="status"
        aria-live="polite"
    ></p>
    <nav
        class="agent-settings-tabs tab-switcher allow-overflow"
        aria-label="{{t 'Agent settings' }}"
    >
        <button
            type="button"
            class="ind-tab first selected"
            data-agent-tab="directory"
        >{{t "Agent directory"}}</button>
        <button
            type="button"
            class="ind-tab middle"
            data-agent-tab="devices"
        >{{t "Devices"}}</button>
        <button
            type="button"
            class="ind-tab middle"
            data-agent-tab="connections"
        >{{t "Model connections"}}</button>
        <button
            type="button"
            class="ind-tab last"
            data-agent-tab="default"
        >{{t "Team default"}}</button>
    </nav>
    <section
        id="agent-directory-panel"
        class="agent-settings-panel"
        aria-labelledby="agent-directory-heading"
    >
        <h3 id="agent-directory-heading">{{t "Agent directory"}}</h3>
        <form id="agent-directory-filter" class="agent-inline-form">
            <label
                class="settings-field-label"
                for="agent-search"
            >{{t "Search profiles"}}</label><input
                id="agent-search"
                class="settings_text_input"
                type="search"
                maxlength="100"
            />
            <label
                class="settings-field-label"
                for="agent-ownership"
            >{{t "Ownership"}}</label><select
                id="agent-ownership"
                class="settings_select bootstrap-focus-style"
            ><option value="all">{{t "All"}}</option><option
                    value="mine"
                >{{t "Mine"}}</option><option value="shared">{{t "Shared"}}</option></select>
            <label
                class="settings-field-label"
                for="agent-access"
            >{{t "Access"}}</label><select
                id="agent-access"
                class="settings_select bootstrap-focus-style"
            ><option value="all">{{t "All"}}</option><option
                    value="complete"
                >{{t "Complete"}}</option><option
                    value="partial"
                >{{t "Partial"}}</option></select>
            <label
                class="settings-field-label"
                for="agent-host-filter"
            >{{t "Device category"}}</label><select
                id="agent-host-filter"
                class="settings_select bootstrap-focus-style"
            ><option value="all">{{t "All"}}</option><option
                    value="workstation"
                >{{t "Workstation"}}</option><option
                    value="server"
                >{{t "Server"}}</option><option
                    value="unknown"
                >{{t "Unknown"}}</option></select>
            <button
                type="submit"
                class="action-button action-button-subtle-neutral"
            >{{t "Apply filters"}}</button>
        </form>
        <p id="agent-directory-count" role="status"></p><div
            id="agent-profile-list"
            class="agent-cards"
        ></div>
        <div class="agent-pagination"><button
                type="button"
                id="agent-directory-prev"
                class="action-button action-button-subtle-neutral"
            >{{t "Previous"}}</button><button
                type="button"
                id="agent-directory-next"
                class="action-button action-button-subtle-neutral"
            >{{t "Next"}}</button></div>
        <button
            type="button"
            id="agent-new-profile"
            class="action-button action-button-solid-brand"
        >{{t "Create agent profile"}}</button>
        <section aria-labelledby="agent-recent-jobs-heading"><h4
                id="agent-recent-jobs-heading"
            >{{t "Recent agent jobs"}}</h4><button
                type="button"
                id="agent-load-jobs"
                class="action-button action-button-subtle-neutral"
            >{{t "Load jobs"}}</button><div id="agent-recent-jobs"></div></section>
        <form id="agent-profile-form" class="agent-editor" hidden>
            <h4 id="agent-profile-form-title">{{t "Agent profile"}}</h4>
            <p id="agent-profile-step-label" role="status"></p>
            <fieldset data-agent-step="0"><legend>{{t "Identity"}}</legend>
                <label
                    class="settings-field-label"
                    for="agent-profile-name"
                >{{t "Name"}}</label><input
                    id="agent-profile-name"
                    class="settings_text_input"
                    required
                    maxlength="200"
                />
                <label
                    class="settings-field-label"
                    for="agent-profile-description"
                >{{t "Description"}}</label><textarea
                    id="agent-profile-description"
                    class="settings-textarea"
                    maxlength="2000"
                ></textarea>
                <p class="agent-field-note">{{t "The description helps people choose an
                    agent. The agent does not read it."}}</p>
                <label
                    class="settings-field-label"
                    for="agent-profile-instructions"
                >{{t "Agent instructions"}}</label><textarea
                    id="agent-profile-instructions"
                    class="settings-textarea"
                    maxlength="8000"
                ></textarea>
                <p class="agent-field-note">{{t "The agent reads these instructions at
                    the start of each task. A change needs a new check before the agent
                    takes tasks again."}}</p>
            </fieldset>
            <fieldset data-agent-step="1" hidden><legend>{{t "Runner"}}</legend>
                <label
                    class="settings-field-label"
                    for="agent-profile-runner"
                >{{t "Selected device"}}</label><select
                    id="agent-profile-runner"
                    class="settings_select bootstrap-focus-style"
                    required
                ></select>
                <p>{{t "Tool execution runs on the selected device. Its owner
                    declares the device type."}}</p>
            </fieldset>
            <fieldset data-agent-step="2" hidden><legend>{{t "Runtime"}}</legend>
                <label
                    class="settings-field-label"
                    for="agent-profile-adapter"
                >{{t "Approved adapter"}}</label><select
                    id="agent-profile-adapter"
                    class="settings_select bootstrap-focus-style"
                    required
                ></select>
                <label
                    class="settings-field-label"
                    for="agent-profile-mode"
                >{{t "Runtime mode"}}</label><select
                    id="agent-profile-mode"
                    class="settings_select bootstrap-focus-style"
                ><option value="acp">{{t "ACP"}}</option><option
                        value="endpoint"
                    >{{t "Endpoint"}}</option></select>
                <label
                    class="settings-field-label"
                    for="agent-profile-provider"
                >{{t "Model connection"}}</label><select
                    id="agent-profile-provider"
                    class="settings_select bootstrap-focus-style"
                ></select>
                <label
                    class="settings-field-label"
                    for="agent-profile-sandbox"
                >{{t "Approved sandbox"}}</label><select
                    id="agent-profile-sandbox"
                    class="settings_select bootstrap-focus-style"
                    required
                ></select>
            </fieldset>
            <fieldset data-agent-step="3" hidden><legend>{{t "Work"}}</legend>
                <label
                    class="settings-field-label"
                    for="agent-profile-default-mode"
                >{{t "Default task type"}}</label><select
                    id="agent-profile-default-mode"
                    class="settings_select bootstrap-focus-style"
                ><option value="answer">{{t "Answer"}}</option><option
                        value="code"
                    >{{t "Coding"}}</option><option
                        value="manage"
                        id="agent-profile-default-mode-manage"
                    >{{t "Team management"}}</option></select>
                <p
                    id="agent-profile-manage-note"
                    class="agent-field-note"
                    hidden
                >{{t "Only organization administrators can turn on team management."}}</p>
                <label
                    class="settings-field-label"
                    for="agent-profile-repository"
                >{{t "Repository binding"}}</label><select
                    id="agent-profile-repository"
                    class="settings_select bootstrap-focus-style"
                ></select>
                <label
                    class="settings-field-label"
                    for="agent-profile-active-seconds"
                >{{t "Maximum active seconds"}}</label><input
                    id="agent-profile-active-seconds"
                    class="settings_text_input"
                    type="number"
                    min="1"
                    max="7200"
                    value="3600"
                />
                <label
                    class="settings-field-label"
                    for="agent-profile-input-tokens"
                >{{t "Input tokens"}}</label><input
                    id="agent-profile-input-tokens"
                    class="settings_text_input"
                    type="number"
                    min="1"
                    value="1024"
                />
                <label
                    class="settings-field-label"
                    for="agent-profile-output-tokens"
                >{{t "Output tokens"}}</label><input
                    id="agent-profile-output-tokens"
                    class="settings_text_input"
                    type="number"
                    min="1"
                    value="512"
                />
            </fieldset>
            <fieldset data-agent-step="4" hidden><legend>{{t "Access"}}</legend>
                <label class="checkbox"><input
                        id="agent-profile-context"
                        type="checkbox"
                        checked
                    /><span class="rendered-checkbox"></span>{{t "Read selected
                    context"}}</label>
                <label class="checkbox"><input
                        id="agent-profile-shell"
                        type="checkbox"
                    /><span class="rendered-checkbox"></span>{{t "Use approved tools"}}</label>
                <label class="checkbox"><input
                        id="agent-profile-repository-read"
                        type="checkbox"
                    /><span class="rendered-checkbox"></span>{{t "Read repository"}}</label>
                <label class="checkbox"><input
                        id="agent-profile-repository-edit"
                        type="checkbox"
                    /><span class="rendered-checkbox"></span>{{t "Edit repository"}}</label>
                <label class="checkbox"><input
                        id="agent-profile-checks"
                        type="checkbox"
                    /><span class="rendered-checkbox"></span>{{t "Run required checks"}}</label>
                <label class="checkbox"><input
                        id="agent-profile-dependencies"
                        type="checkbox"
                    /><span class="rendered-checkbox"></span>{{t "Install dependencies"}}</label>
                <label class="checkbox"><input
                        id="agent-profile-commit"
                        type="checkbox"
                    /><span class="rendered-checkbox"></span>{{t "Create Git commits"}}</label>
                <label class="checkbox"><input
                        id="agent-profile-push"
                        type="checkbox"
                    /><span class="rendered-checkbox"></span>{{t "Push Git changes"}}</label>
                <label class="checkbox"><input
                        id="agent-profile-pr"
                        type="checkbox"
                    /><span class="rendered-checkbox"></span>{{t "Create draft pull
                    requests"}}</label>
                <label class="checkbox"><input
                        id="agent-profile-hard-cap"
                        type="checkbox"
                    /><span class="rendered-checkbox"></span>{{t "Enforce a hard cost
                    cap"}}</label>
                <p id="agent-profile-network-note">{{t "Localhost addresses refer to
                    the selected runner."}}</p>
            </fieldset>
            <fieldset data-agent-step="5" hidden><legend>{{t "Review"}}</legend><p
                    id="agent-profile-review"
                ></p><p>{{t "A saved draft needs a probe and explicit enable before
                    it accepts tasks."}}</p></fieldset>
            <div class="agent-actions"><button
                    type="button"
                    id="agent-profile-back"
                    class="action-button action-button-subtle-neutral"
                >{{t "Back"}}</button><button
                    type="button"
                    id="agent-profile-next"
                    class="action-button action-button-subtle-neutral"
                >{{t "Next"}}</button>
                <button
                    type="submit"
                    id="agent-profile-save"
                    class="action-button action-button-solid-brand"
                    hidden
                >{{t "Save draft"}}</button><button
                    type="button"
                    id="agent-profile-cancel"
                    class="action-button action-button-subtle-neutral"
                >{{t "Close"}}</button></div>
            <p id="agent-profile-result" role="status" aria-live="polite"></p>
        </form>
        <div id="agent-profile-detail" class="agent-editor" hidden></div>
    </section>
    <section
        id="agent-devices-panel"
        class="agent-settings-panel"
        aria-labelledby="agent-devices-heading"
        hidden
    >
        <h3 id="agent-devices-heading">{{t "Devices"}}</h3><p>{{t "Pair a workstation or
            server with the same code. The owner declares its category."}}</p>
        <h4>{{t "Connect a device"}}</h4>
        <ol id="agent-connect-steps"></ol>
        <form id="agent-pairing-form" class="agent-inline-form"><label
                class="settings-field-label"
                for="agent-pairing-id"
            >{{t "Pairing ID"}}</label><input
                id="agent-pairing-id"
                class="settings_text_input"
                required
            />
            <label
                class="settings-field-label"
                for="agent-pairing-code"
            >{{t "Code shown on device"}}</label><input
                id="agent-pairing-code"
                class="settings_text_input"
                required
            /><button
                type="button"
                id="agent-pairing-check"
                class="action-button action-button-subtle-neutral"
            >{{t "Check code"}}</button>
            <div id="agent-pairing-preview" class="agent-card" hidden></div>
            <p id="agent-pairing-result" role="status"></p><button
                type="submit"
                id="agent-pairing-approve"
                class="action-button action-button-solid-brand"
                disabled
            >{{t "Approve pairing"}}</button></form>
        <div id="agent-pairing-added" hidden><p>{{t "Device connected. You can add an agent
                that runs on it."}}</p><button
                type="button"
                class="action-button action-button-solid-brand"
                data-agent-action="profile-new-on-runner"
            >{{t "Add agent on this device"}}</button></div>
        <p id="agent-device-count"></p><div
            id="agent-runner-list"
            class="agent-cards"
        ></div><button
            type="button"
            id="agent-device-more"
            class="action-button action-button-subtle-neutral"
        >{{t "Load more devices"}}</button>
        <h4>{{t "Repositories"}}</h4><div id="agent-repository-list" class="agent-cards"></div>
        <form id="agent-runner-form" class="agent-editor" hidden><h4>{{t "Edit device
                metadata"}}</h4>
            <label
                class="settings-field-label"
                for="agent-runner-name"
            >{{t "Device name"}}</label><input
                id="agent-runner-name"
                class="settings_text_input"
                required
                maxlength="200"
            />
            <label
                class="settings-field-label"
                for="agent-runner-kind"
            >{{t "Declared category"}}</label><select
                id="agent-runner-kind"
                class="settings_select bootstrap-focus-style"
            ><option value="unknown">{{t "Unknown"}}</option><option
                    value="workstation"
                >{{t "Workstation"}}</option><option
                    value="server"
                >{{t "Server"}}</option></select>
            <div class="agent-actions"><button
                    type="submit"
                    class="action-button action-button-solid-brand"
                >{{t "Save metadata"}}</button><button
                    type="button"
                    id="agent-runner-cancel"
                    class="action-button action-button-subtle-neutral"
                >{{t "Close"}}</button></div></form>
        <form id="agent-repository-form" class="agent-editor" hidden><h4
            >{{t "Register repository"}}</h4><p>{{t "Register only aliases that already exist
                in the selected runner catalog."}}</p>
            <label
                class="settings-field-label"
                for="agent-repository-alias"
            >{{t "Workspace alias"}}</label><input
                id="agent-repository-alias"
                class="settings_text_input"
                required
                pattern="[A-Za-z0-9_-]+"
            />
            <label
                class="settings-field-label"
                for="agent-repository-origin"
            >{{t "Canonical origin"}}</label><input
                id="agent-repository-origin"
                class="settings_text_input"
                type="url"
            />
            <label
                class="settings-field-label"
                for="agent-repository-ref"
            >{{t "Allowed ref"}}</label><input
                id="agent-repository-ref"
                class="settings_text_input"
                required
            />
            <div class="agent-actions"><button
                    type="submit"
                    class="action-button action-button-solid-brand"
                >{{t "Register repository"}}</button><button
                    type="button"
                    id="agent-repository-cancel"
                    class="action-button action-button-subtle-neutral"
                >{{t "Close"}}</button></div><p
                id="agent-repository-result"
                role="status"
            ></p></form>
    </section>
    <section
        id="agent-connections-panel"
        class="agent-settings-panel"
        aria-labelledby="agent-connections-heading"
        hidden
    >
        <h3 id="agent-connections-heading">{{t "Model connections"}}</h3><p>{{t "Credentials
            are write-only. Replacement fields stay empty after a read."}}</p>
        <div id="agent-provider-list" class="agent-cards"></div><button
            type="button"
            id="agent-provider-more"
            class="action-button action-button-subtle-neutral"
        >{{t "Load more connections"}}</button>
        <button
            type="button"
            id="agent-new-provider"
            class="action-button action-button-solid-brand"
        >{{t "Add model connection"}}</button>
        <form id="agent-provider-form" class="agent-editor" hidden><h4
                id="agent-provider-form-title"
            >{{t "Model connection"}}</h4>
            <label
                class="settings-field-label"
                for="agent-provider-runner"
            >{{t "Runner"}}</label><select
                id="agent-provider-runner"
                class="settings_select bootstrap-focus-style"
                required
            ></select>
            <label
                class="settings-field-label"
                for="agent-provider-name"
            >{{t "Name"}}</label><input
                id="agent-provider-name"
                class="settings_text_input"
                required
                maxlength="200"
            />
            <label
                class="settings-field-label"
                for="agent-provider-url"
            >{{t "Endpoint URL"}}</label><input
                id="agent-provider-url"
                class="settings_text_input"
                required
                maxlength="2048"
                type="url"
            />
            <label
                class="settings-field-label"
                for="agent-provider-api-mode"
            >{{t "API mode"}}</label><select
                id="agent-provider-api-mode"
                class="settings_select bootstrap-focus-style"
            ><option value="chat_completions">{{t "Chat completions"}}</option><option
                    value="responses"
                >{{t "Responses"}}</option></select>
            <label
                class="settings-field-label"
                for="agent-provider-model"
            >{{t "Model ID"}}</label><input
                id="agent-provider-model"
                class="settings_text_input"
                required
                maxlength="200"
            />
            <label
                class="settings-field-label"
                for="agent-provider-allowed-models"
            >{{t "Allowed model IDs, one per line"}}</label><textarea
                id="agent-provider-allowed-models"
                class="settings-textarea"
                required
            ></textarea>
            <label
                class="settings-field-label"
                for="agent-provider-context"
            >{{t "Context window tokens"}}</label><input
                id="agent-provider-context"
                class="settings_text_input"
                type="number"
                required
                min="1"
                value="8192"
            />
            <label
                class="settings-field-label"
                for="agent-provider-output"
            >{{t "Maximum output tokens"}}</label><input
                id="agent-provider-output"
                class="settings_text_input"
                type="number"
                required
                min="1"
                value="2048"
            />
            <label
                class="settings-field-label"
                for="agent-provider-credential"
            >{{t "Replacement credential"}}</label><input
                id="agent-provider-credential"
                class="settings_text_input"
                type="password"
                autocomplete="new-password"
            />
            <label
                class="settings-field-label"
                for="agent-provider-local-ref"
            >{{t "Local credential reference"}}</label><input
                id="agent-provider-local-ref"
                class="settings_text_input"
                autocomplete="off"
            />
            <label
                class="settings-field-label"
                for="agent-provider-network-host"
            >{{t "Allowed network hostname"}}</label><input
                id="agent-provider-network-host"
                class="settings_text_input"
            />
            <label
                class="settings-field-label"
                for="agent-provider-network-port"
            >{{t "Allowed network port"}}</label><input
                id="agent-provider-network-port"
                class="settings_text_input"
                type="number"
                min="1"
                max="65535"
                value="443"
            />
            <label class="checkbox"><input
                    id="agent-provider-network-private"
                    type="checkbox"
                /><span class="rendered-checkbox"></span>{{t "Permit private network
                target"}}</label>
            <label class="checkbox"><input
                    id="agent-provider-network-loopback"
                    type="checkbox"
                /><span class="rendered-checkbox"></span>{{t "Permit HTTP loopback on
                the runner"}}</label>
            <label class="checkbox"><input
                    id="agent-provider-network-http-private"
                    type="checkbox"
                /><span class="rendered-checkbox"></span>{{t "Permit HTTP on an
                approved private target"}}</label>
            <fieldset id="agent-provider-scopes"><legend>{{t "Data scopes"}}</legend>
                <label class="checkbox"><input
                        type="checkbox"
                        value="synthetic"
                    /><span class="rendered-checkbox"></span>{{t "Synthetic"}}</label>
                <label class="checkbox"><input
                        type="checkbox"
                        value="selected_chat"
                    /><span class="rendered-checkbox"></span>{{t "Selected chat"}}</label>
                <label class="checkbox"><input
                        type="checkbox"
                        value="selected_repository"
                    /><span class="rendered-checkbox"></span>{{t "Selected repository"}}</label>
            </fieldset>
            <p>{{t "Localhost addresses refer to the selected runner. An execution
                change makes dependent profiles need a new probe."}}</p>
            <div id="agent-provider-impact" role="status"></div>
            <div class="agent-actions"><button
                    type="submit"
                    class="action-button action-button-solid-brand"
                >{{t "Save connection"}}</button><button
                    type="button"
                    id="agent-provider-cancel"
                    class="action-button action-button-subtle-neutral"
                >{{t "Close"}}</button></div><p
                id="agent-provider-result"
                role="status"
            ></p>
        </form>
    </section>
    <section
        id="agent-default-panel"
        class="agent-settings-panel"
        aria-labelledby="agent-default-heading"
        hidden
    >
        <h3 id="agent-default-heading">{{t "Team default"}}</h3><p>{{t "The default grants no
            access to profiles, devices, connections, or repositories."}}</p>
        <div id="agent-team-default" role="status"></div><form
            id="agent-default-form"
            class="agent-editor"
            hidden
        >
            <label
                class="settings-field-label"
                for="agent-default-choice"
            >{{t "Default profile"}}</label><select
                id="agent-default-choice"
                class="settings_select bootstrap-focus-style"
            ></select>
            <div class="agent-actions"><button
                    type="submit"
                    class="action-button action-button-solid-brand"
                >{{t "Save team default"}}</button><button
                    type="button"
                    id="agent-default-clear"
                    class="action-button action-button-subtle-neutral"
                >{{t "Clear default"}}</button></div></form>
        <h4>{{t "Team instructions"}}</h4>
        <p id="agent-team-instructions-readonly" hidden><span
                id="agent-team-instructions-readonly-text"
            ></span> {{t "Only organization administrators can change the team
                instructions."}}</p>
        <form id="agent-team-instructions-form" class="agent-inline-form" hidden>
            <label
                class="settings-field-label"
                for="agent-team-instructions"
            >{{t "Team instructions"}}</label><textarea
                id="agent-team-instructions"
                class="settings-textarea"
                maxlength="8000"
            ></textarea>
            <p class="agent-field-note">{{t "Every agent in this organization reads
                these instructions at the start of each new task. Running tasks keep
                the instructions they started with."}}</p>
            <button
                type="submit"
                class="action-button action-button-solid-brand"
            >{{t "Save team instructions"}}</button>
            <p id="agent-team-instructions-status" role="status"></p>
        </form>
    </section>
    <div id="agent-grant-editor" class="agent-editor" hidden></div>
</div>
