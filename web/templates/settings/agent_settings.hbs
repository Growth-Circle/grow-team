<div class="settings-section" id="agent-settings" data-name="agents">
    <div class="section-header"><h2>{{t "Agents"}}</h2><p>{{t
                "Manage agent profiles, devices, model connections, and the team default."
            }}</p></div>
    <p
        id="agent-settings-status"
        class="alert"
        role="status"
        aria-live="polite"
    ></p>
    <nav class="agent-settings-tabs" aria-label="Agent settings">
        <button type="button" data-agent-tab="directory">Agent directory</button>
        <button type="button" data-agent-tab="devices">Devices</button>
        <button type="button" data-agent-tab="connections">Model connections</button>
        <button type="button" data-agent-tab="default">Team default</button>
    </nav>
    <section
        id="agent-directory-panel"
        class="agent-settings-panel"
        aria-labelledby="agent-directory-heading"
    >
        <h3 id="agent-directory-heading">Agent directory</h3>
        <form id="agent-directory-filter" class="agent-inline-form">
            <label for="agent-search">Search profiles</label><input
                id="agent-search"
                type="search"
                maxlength="100"
            />
            <label for="agent-ownership">Ownership</label><select
                id="agent-ownership"
            ><option value="all">All</option><option
                    value="mine"
                >Mine</option><option value="shared">Shared</option></select>
            <label for="agent-access">Access</label><select
                id="agent-access"
            ><option value="all">All</option><option
                    value="complete"
                >Complete</option><option
                    value="partial"
                >Partial</option></select>
            <label for="agent-host-filter">Device category</label><select
                id="agent-host-filter"
            ><option value="all">All</option><option
                    value="workstation"
                >Workstation</option><option
                    value="server"
                >Server</option><option
                    value="unknown"
                >Unknown</option></select>
            <button type="submit">Apply filters</button>
        </form>
        <p id="agent-directory-count" role="status"></p><div
            id="agent-profile-list"
            class="agent-cards"
        ></div>
        <div class="agent-pagination"><button
                type="button"
                id="agent-directory-prev"
            >Previous</button><button
                type="button"
                id="agent-directory-next"
            >Next</button></div>
        <button type="button" id="agent-new-profile">Create agent profile</button>
        <section aria-labelledby="agent-recent-jobs-heading"><h4
                id="agent-recent-jobs-heading"
            >Recent agent jobs</h4><button
                type="button"
                id="agent-load-jobs"
            >Load jobs</button><div id="agent-recent-jobs"></div></section>
        <form id="agent-profile-form" class="agent-editor" hidden>
            <h4 id="agent-profile-form-title">Agent profile</h4>
            <p id="agent-profile-step-label" role="status"></p>
            <fieldset data-agent-step="0"><legend>Identity</legend>
                <label for="agent-profile-name">Name</label><input
                    id="agent-profile-name"
                    required
                    maxlength="200"
                />
                <label
                    for="agent-profile-description"
                >Description</label><textarea
                    id="agent-profile-description"
                    maxlength="2000"
                ></textarea>
            </fieldset>
            <fieldset data-agent-step="1" hidden><legend>Runner</legend>
                <label for="agent-profile-runner">Selected device</label><select
                    id="agent-profile-runner"
                    required
                ></select>
                <p>Tool execution runs on this device. Its category is declared
                    by its owner.</p>
            </fieldset>
            <fieldset data-agent-step="2" hidden><legend>Runtime</legend>
                <label for="agent-profile-adapter">Approved adapter</label><select
                    id="agent-profile-adapter"
                    required
                ></select>
                <label for="agent-profile-mode">Runtime mode</label><select
                    id="agent-profile-mode"
                ><option value="acp">ACP</option><option
                        value="endpoint"
                    >Endpoint</option></select>
                <label for="agent-profile-provider">Model connection</label><select
                    id="agent-profile-provider"
                ></select>
                <label for="agent-profile-sandbox">Approved sandbox</label><select
                    id="agent-profile-sandbox"
                    required
                ></select>
            </fieldset>
            <fieldset data-agent-step="3" hidden><legend>Work</legend>
                <label for="agent-profile-default-mode">Default task type</label><select
                    id="agent-profile-default-mode"
                ><option value="answer">Answer</option><option
                        value="code"
                    >Coding</option></select>
                <label for="agent-profile-repository">Repository binding</label><select
                    id="agent-profile-repository"
                ></select>
                <label for="agent-profile-active-seconds">Maximum active seconds</label><input
                    id="agent-profile-active-seconds"
                    type="number"
                    min="1"
                    max="7200"
                    value="3600"
                />
                <label for="agent-profile-input-tokens">Input tokens</label><input
                    id="agent-profile-input-tokens"
                    type="number"
                    min="1"
                    value="1024"
                />
                <label for="agent-profile-output-tokens">Output tokens</label><input
                    id="agent-profile-output-tokens"
                    type="number"
                    min="1"
                    value="512"
                />
            </fieldset>
            <fieldset data-agent-step="4" hidden><legend>Access</legend>
                <label><input
                        id="agent-profile-context"
                        type="checkbox"
                        checked
                    />Read selected context</label>
                <label><input id="agent-profile-shell" type="checkbox" />Use
                    approved tools</label>
                <label><input
                        id="agent-profile-repository-read"
                        type="checkbox"
                    />Read repository</label>
                <label><input
                        id="agent-profile-repository-edit"
                        type="checkbox"
                    />Edit repository</label>
                <label><input id="agent-profile-checks" type="checkbox" />Run
                    required checks</label>
                <label><input
                        id="agent-profile-dependencies"
                        type="checkbox"
                    />Install dependencies</label>
                <label><input id="agent-profile-commit" type="checkbox" />Create
                    Git commits</label>
                <label><input id="agent-profile-push" type="checkbox" />Push Git
                    changes</label>
                <label><input id="agent-profile-pr" type="checkbox" />Create
                    draft pull requests</label>
                <label><input
                        id="agent-profile-hard-cap"
                        type="checkbox"
                    />Enforce a hard cost cap</label>
                <p id="agent-profile-network-note">Localhost addresses refer to
                    the selected runner.</p>
            </fieldset>
            <fieldset data-agent-step="5" hidden><legend>Review</legend><p
                    id="agent-profile-review"
                ></p><p>A saved draft needs a probe and explicit enable before
                    it accepts tasks.</p></fieldset>
            <div class="agent-actions"><button
                    type="button"
                    id="agent-profile-back"
                >Back</button><button
                    type="button"
                    id="agent-profile-next"
                >Next</button>
                <button type="submit" id="agent-profile-save" hidden>Save draft</button><button
                    type="button"
                    id="agent-profile-cancel"
                >Close</button></div>
            <p id="agent-profile-result" role="status" aria-live="polite"></p>
        </form>
        <div id="agent-profile-detail" class="agent-editor" hidden></div>
    </section>
    <section
        id="agent-devices-panel"
        class="agent-settings-panel"
        aria-labelledby="agent-devices-heading"
        hidden
    >
        <h3 id="agent-devices-heading">Devices</h3><p>Pair a workstation or
            server with the same code. The owner declares its category.</p>
        <form id="agent-pairing-form" class="agent-inline-form"><label
                for="agent-pairing-id"
            >Pairing ID</label><input id="agent-pairing-id" required />
            <label for="agent-pairing-code">Code shown on device</label><input
                id="agent-pairing-code"
                required
            /><button type="submit">Approve pairing</button></form>
        <p id="agent-device-count"></p><div
            id="agent-runner-list"
            class="agent-cards"
        ></div><button type="button" id="agent-device-more">Load more devices</button>
        <h4>Repositories</h4><div id="agent-repository-list" class="agent-cards"></div>
        <form id="agent-runner-form" class="agent-editor" hidden><h4>Edit device
                metadata</h4>
            <label for="agent-runner-name">Device name</label><input
                id="agent-runner-name"
                required
                maxlength="200"
            />
            <label for="agent-runner-kind">Declared category</label><select
                id="agent-runner-kind"
            ><option value="unknown">Unknown</option><option
                    value="workstation"
                >Workstation</option><option
                    value="server"
                >Server</option></select>
            <button type="submit">Save metadata</button><button
                type="button"
                id="agent-runner-cancel"
            >Close</button></form>
        <form id="agent-repository-form" class="agent-editor" hidden><h4
            >Register repository</h4><p>Register only aliases that already exist
                in the selected runner catalog.</p>
            <label for="agent-repository-alias">Workspace alias</label><input
                id="agent-repository-alias"
                required
                pattern="[A-Za-z0-9_-]+"
            />
            <label for="agent-repository-origin">Canonical origin</label><input
                id="agent-repository-origin"
                type="url"
            />
            <label for="agent-repository-ref">Allowed ref</label><input
                id="agent-repository-ref"
                required
            />
            <button type="submit">Register repository</button><button
                type="button"
                id="agent-repository-cancel"
            >Close</button><p id="agent-repository-result" role="status"></p></form>
    </section>
    <section
        id="agent-connections-panel"
        class="agent-settings-panel"
        aria-labelledby="agent-connections-heading"
        hidden
    >
        <h3 id="agent-connections-heading">Model connections</h3><p>Credentials
            are write-only. Replacement fields stay empty after a read.</p>
        <div id="agent-provider-list" class="agent-cards"></div><button
            type="button"
            id="agent-provider-more"
        >Load more connections</button>
        <button type="button" id="agent-new-provider">Add model connection</button>
        <form id="agent-provider-form" class="agent-editor" hidden><h4
                id="agent-provider-form-title"
            >Model connection</h4>
            <label for="agent-provider-runner">Runner</label><select
                id="agent-provider-runner"
                required
            ></select>
            <label for="agent-provider-name">Name</label><input
                id="agent-provider-name"
                required
                maxlength="200"
            />
            <label for="agent-provider-url">Endpoint URL</label><input
                id="agent-provider-url"
                required
                maxlength="2048"
                type="url"
            />
            <label for="agent-provider-api-mode">API mode</label><select
                id="agent-provider-api-mode"
            ><option value="chat_completions">Chat completions</option><option
                    value="responses"
                >Responses</option></select>
            <label for="agent-provider-model">Model ID</label><input
                id="agent-provider-model"
                required
                maxlength="200"
            />
            <label for="agent-provider-allowed-models">Allowed model IDs, one
                per line</label><textarea
                id="agent-provider-allowed-models"
                required
            ></textarea>
            <label for="agent-provider-context">Context window tokens</label><input
                id="agent-provider-context"
                type="number"
                required
                min="1"
                value="8192"
            />
            <label for="agent-provider-output">Maximum output tokens</label><input
                id="agent-provider-output"
                type="number"
                required
                min="1"
                value="2048"
            />
            <label for="agent-provider-credential">Replacement credential</label><input
                id="agent-provider-credential"
                type="password"
                autocomplete="new-password"
            />
            <label for="agent-provider-local-ref">Local credential reference</label><input
                id="agent-provider-local-ref"
                autocomplete="off"
            />
            <label for="agent-provider-network-host">Allowed network hostname</label><input
                id="agent-provider-network-host"
            />
            <label for="agent-provider-network-port">Allowed network port</label><input
                id="agent-provider-network-port"
                type="number"
                min="1"
                max="65535"
                value="443"
            />
            <label><input
                    id="agent-provider-network-private"
                    type="checkbox"
                />Permit private network target</label>
            <label><input
                    id="agent-provider-network-loopback"
                    type="checkbox"
                />Permit HTTP loopback on the runner</label>
            <label><input
                    id="agent-provider-network-http-private"
                    type="checkbox"
                />Permit HTTP on an approved private target</label>
            <fieldset id="agent-provider-scopes"><legend>Data scopes</legend>
                <label><input
                        type="checkbox"
                        value="synthetic"
                    />Synthetic</label>
                <label><input type="checkbox" value="selected_chat" />Selected
                    chat</label>
                <label><input
                        type="checkbox"
                        value="selected_repository"
                    />Selected repository</label>
            </fieldset>
            <p>Localhost addresses refer to the selected runner. An execution
                change makes dependent profiles need a new probe.</p>
            <div id="agent-provider-impact" role="status"></div>
            <button type="submit">Save connection</button><button
                type="button"
                id="agent-provider-cancel"
            >Close</button><p id="agent-provider-result" role="status"></p>
        </form>
    </section>
    <section
        id="agent-default-panel"
        class="agent-settings-panel"
        aria-labelledby="agent-default-heading"
        hidden
    >
        <h3 id="agent-default-heading">Team default</h3><p>The default grants no
            access to profiles, devices, connections, or repositories.</p>
        <div id="agent-team-default" role="status"></div><form
            id="agent-default-form"
            hidden
        >
            <label for="agent-default-choice">Default profile</label><select
                id="agent-default-choice"
            ></select>
            <button type="submit">Save team default</button><button
                type="button"
                id="agent-default-clear"
            >Clear default</button></form>
    </section>
    <div id="agent-grant-editor" class="agent-editor" hidden></div>
</div>
