{{! What the Playbooks list shows in its region: the playbooks, a
    message when there are none, or a way to try again. }}
{{#if is_guest}}
    {{> components/empty_state size="hero" title=(t "Playbooks are for members.") description=(t "Guests can't open them.")}}
{{else if load_failed}}
    {{> components/empty_state tone="warning" role="alert" title=(t "Playbooks did not load.") action_label=(t "Try again") action_classes="playbooks-retry action-button action-button-subtle-neutral"}}
{{else if loading}}
    <div class="playbooks-list" aria-busy="true">
        <div class="playbooks-skeleton sj-skeleton"></div>
        <div class="playbooks-skeleton sj-skeleton"></div>
        <div class="playbooks-skeleton sj-skeleton"></div>
    </div>
{{else if is_empty}}
    {{> components/empty_state size="hero" title=empty_title description=empty_description action_label=empty_action_label action_classes="playbooks-new action-button action-button-solid-brand"}}
{{else}}
    <ul class="playbooks-list">
        {{#each rows}}
            <li class="playbooks-list-item">
                <a class="playbook-row" href="{{this.hash}}">
                    <span class="playbook-row-main">
                        <span class="playbook-row-title" title="{{this.title}}">{{this.title}}</span>
                        <span class="playbook-row-meta">
                            <span class="playbook-row-author" title="{{this.edited_by}}">{{this.edited_by}}</span>
                            <span class="playbook-row-time" title="{{this.full_time}}">{{this.time}}</span>
                            <span class="playbook-row-revision">{{this.revision_label}}</span>
                        </span>
                    </span>
                    {{#if this.archived}}
                        <span class="playbook-row-tag">{{t "Archived"}}</span>
                    {{/if}}
                </a>
            </li>
        {{/each}}
    </ul>
{{/if}}
